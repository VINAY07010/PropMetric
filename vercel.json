{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/assistant.ts": {
      "includeFiles": "src/data/**"
    },
    "api/assistant/stream.ts": {
      "includeFiles": "src/data/**"
    },
    "api/reports/[reportName].ts": {
      "includeFiles": "Reports/**"
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
